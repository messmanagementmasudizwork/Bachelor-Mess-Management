# ============================================================
# MessPilot — Environment Variables Template
# Copy this to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ============================================================

# ---- Supabase (REQUIRED) -----------------------------------
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_CONNECTION_STRING=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# ---- App Config --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:5000

# ---- Feature Flags (safe defaults) -------------------------
NEXT_PUBLIC_APP_NAME=MessPilot
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAX_FILE_SIZE_MB=5
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
